# =============================================================================
# Personal Zsh settings template
# قالب تنظیمات شخصی Zsh
#
# Copy this file to ~/.zshrc.local.
# این فایل را به ~/.zshrc.local کپی کنید.
#
# This file lives outside the repository and must never be committed.
# این فایل خارج از ریپو قرار دارد و نباید هرگز commit شود.
# =============================================================================

# Example: SSH alias to another personal device
# نمونه: alias اتصال SSH به یکی از دستگاه‌های شخصی
# alias mydevice='ssh -p 22 myusername@192.168.x.x'

# Example: private environment variable
# نمونه: متغیر محیطی خصوصی
# export MY_SECRET_TOKEN="..."

# Example: project-specific configuration
# نمونه: تنظیمات اختصاصی پروژه
#
# if [[ -f "$HOME/.config/my-project/env" ]]; then
#     source "$HOME/.config/my-project/env"
# fi
